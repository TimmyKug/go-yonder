<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Installs the crash recorder in every process, before the app loads. -->
    <provider
      android:name="expo.modules.yonderdevicehealth.CrashRecorderProvider"
      android:authorities="${applicationId}.yonder-crash-recorder"
      android:exported="false"
      android:initOrder="1000" />
  </application>
</manifest>
